---
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';
import { profile } from '../data/portfolio';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const fullTitle = title === profile.name
  ? `${title} · Software Development`
  : `${title} · ${profile.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const hasResume = existsSync(resolve('public/resume.pdf'));
const resume = hasResume ? { href: '/resume.pdf', label: 'resume.pdf' } : { href: '/resume/', label: 'resume' };
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f9f9f6" />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{fullTitle}</title>
    {!noindex && <link rel="canonical" href={canonical.href} />}
    <meta property="og:type" content={Astro.url.pathname === '/' ? 'website' : 'article'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header frame">
      <a class="wordmark" href="/">{profile.domain}</a>
      <nav aria-label="Primary">
        <a href="/#projects">projects</a>
        <a href="/#writing">writing</a>
        <a href="/#background">background</a>
        <a href={resume.href}>{resume.label}</a>
      </nav>
    </header>
    <main id="main" class="frame" tabindex="-1"><slot /></main>
    <footer class="site-footer frame">
      <div class="footer-note">
        <span>Comments on this doc? <a href={profile.linkedin}>Get in touch</a></span>
        <small class="development-credit">Aided in Development: Isaiah Urbano</small>
      </div>
      <nav aria-label="Footer">
        <a href={profile.github}>github</a>
        <a href={profile.linkedin}>linkedin</a>
        <a href={resume.href}>{resume.label}</a>
      </nav>
    </footer>
  </body>
</html>
